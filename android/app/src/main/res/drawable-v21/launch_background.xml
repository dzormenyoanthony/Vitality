<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android-12 launch screen: brand teal fill + the pulse badge lifted
     from design_references/Splash.png (drawable-nodpi/splash_badge.png),
     matching the branded SplashScreen that renders once Flutter is ready.
     Android 12+ uses values-v31/styles.xml (windowSplashScreen*) instead. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item
        android:drawable="@drawable/splash_badge"
        android:gravity="center"
        android:width="272dp"
        android:height="272dp" />
</layer-list>
